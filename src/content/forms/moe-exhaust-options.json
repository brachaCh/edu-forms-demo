      "fields": [
        {
          "key": "moe_intro",
          "label": "בחינת מיצוי אפשרויות טרם הפניית תלמיד לדיון בוועדת זכאות ואפיון",
          "type": "static"
        },
        {
          "key": "purpose_note",
          "label": "מסמך זה משקף את תהליך ההתערבות שבוצע, איכותו ומידת השפעתו על התקדמות התלמיד. ימולא רק עבור תלמידים עם מוגבלות בשכיחות גבוהה (לקות למידה, הפרעת קשב וריכוז, הפרעות התנהגותיות רגשיות, עיכוב התפתחותי/שפתי) המופנים לראשונה לוועדת זכאות ואפיון.",
          "type": "static"
        }
      ],
